{
  "name": "v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test server/*.test.ts src/lab/*.test.ts scripts/*.test.ts",
    "sync:content": "node scripts/sync-content.mjs",
    "bundle:agent": "../node_modules/.bin/esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --outfile=../api/agent.js --banner:js=\"// Generated by v3: npm run bundle:agent (from v3/server/vercel.ts). Do not edit; re-run after content changes.\" --log-level=warning"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
