{
  "redirects": [
    {
      "source": "/new",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/new/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bleach",
      "destination": "/bleach/index.html"
    },
    {
      "source": "/bleach/",
      "destination": "/bleach/index.html"
    },
    {
      "source": "/old",
      "destination": "/old/index.html"
    },
    {
      "source": "/old/",
      "destination": "/old/index.html"
    },
    {
      "source": "/old2",
      "destination": "/old2/index.html"
    },
    {
      "source": "/old2/",
      "destination": "/old2/index.html"
    },
    {
      "source": "/old3",
      "destination": "/old3/index.html"
    },
    {
      "source": "/old3/",
      "destination": "/old3/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/projects/:slug/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/agent.js": {
      "maxDuration": 30
    }
  }
}
